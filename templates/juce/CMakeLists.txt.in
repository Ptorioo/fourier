cmake_minimum_required(VERSION 3.22)
project(@NAME@ VERSION 0.1.0 LANGUAGES C CXX)

set(FOURIER_JUCE_PATH "" CACHE PATH "Local JUCE source checkout")
if(NOT EXISTS "${FOURIER_JUCE_PATH}/CMakeLists.txt")
    message(FATAL_ERROR "Set FOURIER_JUCE_PATH to your local JUCE checkout")
endif()
add_subdirectory("${FOURIER_JUCE_PATH}" "${CMAKE_BINARY_DIR}/JUCE")

juce_add_plugin(@NAME@
    COMPANY_NAME "@MANUFACTURER_CODE@"
    BUNDLE_ID "com.@MANUFACTURER_CODE@.@NAME@"
    PLUGIN_MANUFACTURER_CODE @MANUFACTURER_CODE@
    PLUGIN_CODE @PLUGIN_CODE@
    PRODUCT_NAME "@NAME@"
    IS_SYNTH @SYNTH@
    NEEDS_MIDI_INPUT @SYNTH@
    NEEDS_MIDI_OUTPUT FALSE
    IS_MIDI_EFFECT FALSE
    COPY_PLUGIN_AFTER_BUILD FALSE
    FORMATS VST3)

file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/fourier-vst3-$<CONFIG>.txt"
    CONTENT "$<TARGET_GENEX_EVAL:@NAME@_VST3,$<TARGET_PROPERTY:@NAME@_VST3,JUCE_PLUGIN_ARTEFACT_FILE>>\n")

target_sources(@NAME@ PRIVATE PluginProcessor.cpp PluginProcessor.h StarterDSP.h SubtractiveVoice.h)
target_compile_features(@NAME@ PRIVATE cxx_std_17)
target_compile_definitions(@NAME@ PUBLIC
    JUCE_WEB_BROWSER=0
    JUCE_USE_CURL=0
    JUCE_VST3_CAN_REPLACE_VST2=0)
target_link_libraries(@NAME@ PRIVATE juce::juce_audio_utils juce::juce_dsp
    PUBLIC juce::juce_recommended_config_flags juce::juce_recommended_warning_flags)
